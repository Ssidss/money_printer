# ============================================================
# Money Printer — 環境變數範本
# 複製此檔案為 .env 並填入真實值
# cp .env.example .env
# ============================================================

# === 資料庫 (PostgreSQL) ===
# DB_HOST 空 = 使用嵌入式 PostgreSQL；有值 = 連外部資料庫
DB_HOST=
DB_PORT=54330
DB_USER=postgres
DB_PASSWORD=
DB_NAME=money_printer

# === 嵌入式 PostgreSQL 配置 ===
# DATA_DIR: 嵌入式 PG 資料目錄（與記憶引擎共用）
#   空 = ~/.kingarmy/db/
# 覆寫例子: DATA_DIR=/custom/path/to/db
DATA_DIR=

# EMBEDDED_PG_PORT: 嵌入式 PG 埠號（預設 54330，避免與系統 PG 5432 衝突）
EMBEDDED_PG_PORT=54330

# === 認證 (JWT) ===
# 產生方式: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === 通知 (選填) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# === 排程設定 (24h 制，台灣時間) ===
SCHEDULE_TW_HOUR=18
SCHEDULE_TW_MINUTE=30
SCHEDULE_US_HOUR=6
SCHEDULE_US_MINUTE=30

# === 部署 ===
# 多個 origin 用逗號分隔
ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# === 記憶引擎 ===
# 記憶引擎 API URL
MEMORY_ENGINE_URL=http://localhost:8001

# 預設市場 (用於 VBT 回測記憶寫入)
DEFAULT_MARKET=us

# === 前端 (放在 frontend/.env.local) ===
# NEXT_PUBLIC_API_URL=http://localhost:8000
